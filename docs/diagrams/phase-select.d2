# Select phase: everything that happens once, before the worker pool starts.
#
# THE ONE NON-GRID DIAGRAM. Every other diagram here is a grid snake; this one
# runs on the layout engine (dagre, from the theme) because it is a branch, not
# a chain, and the grid model handles a fan-out badly:
#
#   - Only one branch target can share a column with the probe, so the other
#     two edges come out as diagonals however the cells are arranged.
#   - Wrapping the three outcomes in a container to dodge that makes the
#     container a single grid cell, and a grid row or column takes the size of
#     its largest member. Side by side, the container stretched the Preflight
#     probe into a wide empty band; stacked as a nested grid, it stretched the
#     Claim issues box into a tall one instead. The distortion moves, it does
#     not go away.
#
# Dagre draws the fan as an actual decision tree and sizes every box to its own
# content. Keep the labels short anyway: this renders at 1134px against a
# ~1012px docs column, and each extra rank costs ~70px of fixed spacing.

direction: right

prof: "Load profile\n+ resolve roles" { class: stage }
prep: "Create batch branch\n+ issue list" { class: stage }

probe: "Preflight\nprobe" {
  class: gate
  shape: diamond
}

skip: "skip\nalready merged" { class: terminal }
review: "review\nresume at\nreview loop" { class: optional }
impl: "implement\nfresh start" { class: stage }

claim: "Claim issues\nadvisory only" { class: stage }

prof -> prep: { class: flow }
prep -> probe: { class: flow }

probe -> skip: { class: flow }
probe -> review: { class: flow }
probe -> impl: { class: flow }

# skip never claims: the work is already merged.
review -> claim: { class: flow }
impl -> claim: { class: flow }
