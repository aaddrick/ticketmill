# Dark palette. Prepended to each diagram body by render.sh.
# Class names must stay in lockstep with theme-light.d2.

vars: {
  d2-config: {
    layout-engine: dagre
    pad: 28
  }
}

# Transparent canvas: d2 paints an opaque white background rect by default,
# which shows up as a white slab behind the dark SVG on a dark page.
style: {
  fill: transparent
}

classes: {
  phase: {
    style: {
      fill: "#111827"
      stroke: "#334155"
      stroke-width: 1
      border-radius: 10
      font-color: "#e2e8f0"
      font-size: 17
      bold: true
    }
  }
  stage: {
    shape: rectangle
    style: {
      bold: false
      fill: "#1e293b"
      stroke: "#64748b"
      stroke-width: 1
      border-radius: 6
      font-color: "#e2e8f0"
      font-size: 14
      shadow: false
    }
  }
  gate: {
    shape: rectangle
    style: {
      bold: false
      fill: "#422006"
      stroke: "#f59e0b"
      stroke-width: 2
      border-radius: 6
      font-color: "#fde68a"
      font-size: 14
    }
  }
  optional: {
    shape: rectangle
    style: {
      bold: false
      fill: "#0f172a"
      stroke: "#475569"
      stroke-width: 1
      stroke-dash: 4
      border-radius: 6
      font-color: "#94a3b8"
      font-size: 14
    }
  }
  terminal: {
    shape: rectangle
    style: {
      bold: false
      fill: "#052e24"
      stroke: "#10b981"
      stroke-width: 2
      border-radius: 6
      font-color: "#a7f3d0"
      font-size: 14
    }
  }
  human: {
    shape: rectangle
    style: {
      bold: false
      fill: "#0c1e3e"
      stroke: "#3b82f6"
      stroke-width: 2
      border-radius: 6
      font-color: "#bfdbfe"
      font-size: 14
    }
  }
  flow: {
    style: {
      bold: false
      stroke: "#94a3b8"
      stroke-width: 2
      font-color: "#cbd5e1"
      font-size: 12
    }
  }
  loop: {
    style: {
      bold: false
      stroke: "#fbbf24"
      stroke-width: 2
      stroke-dash: 4
      font-color: "#fcd34d"
      font-size: 12
      italic: true
    }
  }
}
